# Caddy reverse proxy for cpmaiexamprep.com
#
# Caddy auto-issues + auto-renews Let's Encrypt certs for any host you
# put in front of a directive — no manual cert handling needed.
#
# Edit /etc/caddy/Caddyfile (or wherever your distro keeps it), reload
# with `sudo systemctl reload caddy`, watch logs:
#     sudo journalctl -u caddy -f
#
# To add another subdomain (e.g. n8n.cpmaiexamprep.com), append a new
# block at the bottom — Caddy issues a fresh cert on the next reload.

# HTTP/3 (QUIC) is disabled deliberately. Caddy's default is to listen
# on udp/443 and stamp `Alt-Svc: h3` with a 30-day lifetime on every
# response; when udp/443 is dropped anywhere on the path (host firewall,
# provider edge, corporate/mobile networks), browsers that cached the
# hint stall on QUIC before falling back to TCP. That surfaced as
# ERR_QUIC_PROTOCOL_ERROR + multi-second page loads for SOME users while
# the site looked healthy on every probe (incidents 2026-08-03 and
# 2026-08-06). h1+h2 over TCP works everywhere; never advertise what the
# network may eat.
#
# NOTE: deploy.sh does NOT converge this file. To apply on the VPS:
#     sudo cp infra/Caddyfile /etc/caddy/Caddyfile
#     sudo caddy validate --config /etc/caddy/Caddyfile
#     sudo systemctl reload caddy      # reload, NOT restart — zero downtime
{
    servers {
        protocols h1 h2
    }
}

# Apex domain → Next.js frontend
#
# Upstreams MUST be 127.0.0.1, never "localhost": prod compose publishes
# the containers on 127.0.0.1 only (IPv4), and Caddy resolves localhost
# to ::1 first → connection refused → sitewide 502 (incident 2026-08-07,
# applying this file over the drifted live config took prod down).
cpmaiexamprep.com {
    encode gzip zstd
    reverse_proxy 127.0.0.1:3000

    # Security headers — already set by FastAPI for /api but harmless
    # to repeat at the edge for the static frontend.
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "DENY"
        Referrer-Policy           "strict-origin-when-cross-origin"
    }

    # Caddy's access log → /var/log/caddy/access.log (rotated by Caddy itself)
    log {
        output file /var/log/caddy/cpmaiexamprep-access.log {
            roll_size 100mb
            roll_keep 5
        }
        format json
    }
}

# www → 301 to apex (canonical hostname)
www.cpmaiexamprep.com {
    redir https://cpmaiexamprep.com{uri} permanent
}

# API subdomain → FastAPI backend
api.cpmaiexamprep.com {
    encode gzip zstd
    reverse_proxy 127.0.0.1:8000

    log {
        output file /var/log/caddy/api-access.log {
            roll_size 100mb
            roll_keep 5
        }
        format json
    }
}
